{
  "schemaVersion": 1,
  "id": "copilot",
  "name": "Copilot",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#A855F7",
  "platformSupport": {
    "windows": {
      "state": "experimental"
    }
  },
  "lines": [
    {
      "type": "progress",
      "label": "AI Credits",
