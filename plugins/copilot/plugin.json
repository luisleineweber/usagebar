      "primaryOrder": 1
    },
    {
      "type": "text",
      "label": "Included Credits",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Billing Mode",
      "scope": "detail"
    },
    {
      "type": "progress",
      "label": "Legacy Premium",
      "scope": "detail"
    },
    {
      "type": "progress",
      "label": "Chat",
      "scope": "overview",
      "primaryOrder": 2
    },
    {
      "type": "progress",
      "label": "Completions",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Legacy Premium Requests",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "http": true,
    "httpDomains": ["api.github.com"]
