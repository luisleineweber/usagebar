{
  "schemaVersion": 1,
  "id": "grok",
  "name": "Grok",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Experimental on Windows. Install Grok CLI and run `grok login` so ~/.grok/auth.json exists before launching UsageBar."
    }
  },
  "links": [
    { "label": "Usage", "url": "https://grok.com/?_s=usage" }
  ],
  "lines": [
    { "type": "progress", "label": "Credits used", "scope": "overview", "primaryOrder": 1 },
    { "type": "badge", "label": "Pay as you go", "scope": "detail" }
  ],
  "capabilities": {
    "http": true,
    "httpDomains": [
      "cli-chat-proxy.grok.com"
    ]
  }
}
