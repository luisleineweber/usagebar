{
  "schemaVersion": 1,
  "id": "stepfun",
  "name": "StepFun",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#2196F2",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Save a current Oasis-Token in Setup or set STEPFUN_TOKEN."
    }
  },
  "sourceProvenance": "privateEndpoint",
  "capabilities": {
    "env": true,
    "providerSecrets": true,
    "http": true,
    "httpDomains": ["platform.stepfun.com"]
  },
  "lines": [
    { "type": "progress", "label": "5-hour", "scope": "overview", "primaryOrder": 1 },
    { "type": "progress", "label": "Weekly", "scope": "overview", "primaryOrder": 2 },
    { "type": "badge", "label": "Plan", "scope": "detail" },
    { "type": "text", "label": "Source", "scope": "detail" },
    { "type": "text", "label": "Auth source", "scope": "detail" }
  ]
}
