{
  "schemaVersion": 1,
  "id": "gemini",
  "name": "Gemini",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#4285F4",
  "defaultPlan": "Free",
  "platformSupport": {
    "windows": {
      "state": "experimental"
    }
  },
  "links": [
    {
      "label": "Status",
      "url": "https://status.cloud.google.com/"
    }
  ],
  "status": {
    "kind": "html",
    "endpoint": "https://status.cloud.google.com/"
  },
  "lines": [
    {
      "type": "progress",
      "label": "Pro",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "progress",
      "label": "Flash",
      "scope": "overview",
      "primaryOrder": 2
    },
    {
      "type": "progress",
      "label": "Flash Lite",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Account",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "fs": true,
    "http": true,
    "ccusage": true,
    "httpDomains": [
      "oauth2.googleapis.com",
      "cloudcode-pa.googleapis.com",
      "cloudresourcemanager.googleapis.com"
    ]
  }
}
