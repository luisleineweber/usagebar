{
  "schemaVersion": 1,
  "id": "perplexity",
  "name": "Perplexity",
  "version": "0.0.2",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#20808D",
  "defaultPlan": "Free",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Experimental on Windows. Save a Perplexity Cookie header or set PERPLEXITY_COOKIE_HEADER before probing."
    }
  },
  "links": [{ "label": "Status", "url": "https://status.perplexity.com/" }],
  "status": {
    "kind": "html"
  },
  "lines": [
    {
      "type": "progress",
      "label": "Recurring credits",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "text",
      "label": "Recurring credits",
      "scope": "overview"
    },
    {
      "type": "progress",
      "label": "Purchased credits",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Purchased credits",
      "scope": "overview"
    },
    {
      "type": "progress",
      "label": "Bonus credits",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Bonus credits",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Auth source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Endpoint",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "env": true,
    "providerSecrets": true,
    "http": true,
    "httpDomains": ["www.perplexity.ai"]
  }
}
