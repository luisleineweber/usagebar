{
  "schemaVersion": 1,
  "id": "doubao",
  "name": "Doubao",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "iconColorMode": "multicolor",
  "brandColor": "#3370FF",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Save a Doubao API key in Setup or set ARK_API_KEY, VOLCENGINE_API_KEY, or DOUBAO_API_KEY."
    }
  },
  "sourceProvenance": "officialApi",
  "capabilities": {
    "env": true,
    "providerSecrets": true,
    "http": true,
    "httpDomains": ["ark.cn-beijing.volces.com"]
  },
  "lines": [
    { "type": "progress", "label": "Requests", "scope": "overview", "primaryOrder": 1 },
    { "type": "badge", "label": "Status", "scope": "overview" },
    { "type": "text", "label": "Source", "scope": "detail" },
    { "type": "text", "label": "Auth source", "scope": "detail" }
  ]
}
