{
  "schemaVersion": 1,
  "id": "opencode",
  "name": "OpenCode Zen",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#111111",
  "defaultPlan": "Pay-as-you-go",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "surfaced": false,
      "message": "Experimental on Windows. Manual cookie mode is the supported setup path right now."
    }
  },
  "links": [
    {
      "label": "Dashboard",
      "url": "https://opencode.ai/"
    }
  ],
  "lines": [
    {
      "type": "text",
      "label": "Balance",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Auth source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Endpoint",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Yesterday",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Last 2 days",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Last 30 days",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "http": true,
    "sqlite": true,
    "httpDomains": ["opencode.ai"]
  }
}
