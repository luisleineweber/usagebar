{
  "schemaVersion": 1,
  "id": "mistral",
  "name": "Mistral",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#FF500F",
  "defaultPlan": "Free",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Experimental on Windows. Save a Mistral Admin API key; browser-session cookies remain a compatibility fallback."
    }
  },
  "links": [
    {
      "label": "Usage",
      "url": "https://admin.mistral.ai/organization/usage"
    },
    {
      "label": "Status",
      "url": "https://status.mistral.ai/"
    }
  ],
  "lines": [
    {
      "type": "text",
      "label": "Spend",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Input tokens",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Output tokens",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Cached tokens",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Models",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Auth source",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Endpoint",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "http": true,
    "httpDomains": ["admin.mistral.ai", "console.mistral.ai"]
  }
}
