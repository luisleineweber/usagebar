{
  "schemaVersion": 1,
  "id": "openrouter",
  "name": "OpenRouter",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "openrouter.svg",
  "brandColor": "#6F42C1",
  "defaultPlan": "Free",
  "platformSupport": {
    "windows": {
      "state": "experimental",
      "message": "Windows experimental. Use a stored OpenRouter management key or OPENROUTER_API_KEY to fetch credits and key-rate data."
    }
  },
  "links": [{ "label": "Status", "url": "https://status.openrouter.ai/" }],
  "status": {
    "kind": "html"
  },
  "lines": [
    {
      "type": "progress",
      "label": "Credits",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "text",
      "label": "Credits",
      "scope": "overview"
    },
    {
      "type": "text",
      "label": "Requests",
      "scope": "detail"
    }
  ],
  "capabilities": {
    "env": true,
    "providerSecrets": true,
    "http": true,
    "httpDomains": ["openrouter.ai"]
  }
}
